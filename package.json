{
  "name": "noorpath",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NoorPath — Private Modular Static PWA for Quran Reading, Hifz, Audio & Hadith on iPad",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/*.test.ts",
    "prepare-data": "python scripts/build_datasets.py"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
